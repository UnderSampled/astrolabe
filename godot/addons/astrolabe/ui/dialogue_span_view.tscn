[gd_scene load_steps=3 format=3]

[sub_resource type="Shader" id="premultiplied_text"]
code = "// The source atlas stores edge colour premultiplied by coverage, but its
// transparent cell padding keeps RGB 0x11. Premultiplied blending needs
// colour no greater than coverage, or every glyph cell lightens the scene.
shader_type canvas_item;
render_mode blend_premul_alpha;

void fragment() {
	COLOR.rgb = min(COLOR.rgb, vec3(COLOR.a));
}
"

[sub_resource type="ShaderMaterial" id="premultiplied"]
shader = SubResource("premultiplied_text")

[node name="Span" type="Label"]
layout_mode = 0
mouse_filter = 2
texture_filter = 2
material = SubResource("premultiplied")
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_constants/outline_size = 0
theme_override_constants/shadow_offset_x = 0
theme_override_constants/shadow_offset_y = 0
theme_override_font_sizes/font_size = 21
clip_text = false
