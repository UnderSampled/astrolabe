[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://game/game_session.gd" id="demo"]
[ext_resource type="Script" path="res://game/session_camera.gd" id="camera"]
[ext_resource type="Script" path="res://game/inventory_host.gd" id="inventory"]
[ext_resource type="PackedScene" path="res://game/pause_host.tscn" id="pause"]
[ext_resource type="PackedScene" path="res://addons/astrolabe/ui/vignette.tscn" id="vignette"]

[node name="ManorDemo" type="Node3D"]
script = ExtResource("demo")

[node name="InventoryHost" type="CanvasLayer" parent="."]
script = ExtResource("inventory")

[node name="PauseHost" parent="." instance=ExtResource("pause")]

[node name="VignetteHost" parent="." instance=ExtResource("vignette")]

[node name="DemoCamera" type="Camera3D" parent="."]
current = true
script = ExtResource("camera")

[node name="Hud" type="CanvasLayer" parent="."]

[node name="Panel" type="PanelContainer" parent="Hud"]
offset_left = 16.0
offset_top = 16.0
offset_right = 392.0
offset_bottom = 236.0
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="Hud/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="Rows" type="VBoxContainer" parent="Hud/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="Title" type="Label" parent="Hud/Panel/Margin/Rows"]
layout_mode = 2
text = "Hype: The Time Quest"

[node name="Status" type="Label" parent="Hud/Panel/Margin/Rows"]
layout_mode = 2
text = "Loading saved game..."
autowrap_mode = 2

[node name="Mana" type="Label" parent="Hud/Panel/Margin/Rows"]
layout_mode = 2

[node name="Save" type="Button" parent="Hud/Panel/Margin/Rows"]
layout_mode = 2
text = "Save Game"

[node name="Controls" type="Label" parent="Hud/Panel/Margin/Rows"]
layout_mode = 2
text = "Arrows  move and turn     Shift  run     Ctrl  jump\nX  draw sword     Space  use sword\nFire: step Down, press X, then Enter\nTab  inventory     F5  save     R  reload save     Esc  pause"
