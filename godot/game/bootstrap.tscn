[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://game/bootstrap.gd" id="bootstrap"]

[sub_resource type="StyleBoxFlat" id="StatusPlate"]
bg_color = Color(0.04, 0.025, 0.015, 0.85)
content_margin_left = 12.0
content_margin_right = 12.0
content_margin_top = 6.0
content_margin_bottom = 6.0

[node name="Astrolabe" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("bootstrap")

[node name="Matte" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.015, 0.01, 0.008, 1)

[node name="MenuHost" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Status" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 12
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -220.0
offset_top = -54.0
offset_right = 220.0
offset_bottom = -8.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StatusPlate")

[node name="Details" type="Label" parent="Status"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 14
text = ""
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="Setup" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -330.0
offset_top = -240.0
offset_right = 330.0
offset_bottom = 240.0
theme_override_styles/panel = SubResource("StatusPlate")

[node name="Rows" type="VBoxContainer" parent="Setup"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Setup/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Prepare Hype for Godot"

[node name="Details" type="Label" parent="Setup/Rows"]
layout_mode = 2
size_flags_vertical = 3
autowrap_mode = 3

[node name="Commands" type="TextEdit" parent="Setup/Rows"]
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
text = "cargo build --release --locked\ntarget/release/astrolabe prepare-game disk godot\ngodot --editor --path godot"
editable = false
wrap_mode = 1

[node name="Help" type="Label" parent="Setup/Rows"]
layout_mode = 2
text = "See README.md for setup and current coverage.\nThe native support example is available at tests/example.tscn."
autowrap_mode = 3

[node name="Quit" type="Button" parent="Setup/Rows"]
layout_mode = 2
text = "Quit"

[connection signal="pressed" from="Setup/Rows/Quit" to="." method="_on_quit_pressed"]
