[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://game/load_game_picker.gd" id="picker"]

[node name="LoadGamePicker" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("picker")

[node name="Matte" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.015, 0.01, 0.008, 0.88)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -250.0
offset_top = -150.0
offset_right = 250.0
offset_bottom = 150.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Rows" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Panel/Margin/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Load Game"

[node name="Saves" type="VBoxContainer" parent="Panel/Margin/Rows"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="Back" type="Button" parent="Panel/Margin/Rows"]
layout_mode = 2
text = "Back"

[connection signal="pressed" from="Panel/Margin/Rows/Back" to="." method="_on_back_pressed"]
