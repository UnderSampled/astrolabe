extends Resource
## Generated by the exporter from the original input module (Fix 7:0) and
## Controls page. Godot terms only: key ids are physical keycodes plus
## KeyLocation << 32; pad buttons are joypad button indices.

## Options-named entries in source table order:
## {name, kind: "key" | "pad" | "pad_direction" | "none", default}.
@export var entries: Array = []
## Script action -> the options entries its source expression ORs together.
@export var actions: Dictionary = {}
## Script action -> Vector3i(axis, min, max) joystick ranges (+-100 scale).
@export var axes: Dictionary = {}
## Key id or pad button -> {label, texture, rect}. Only named inputs can be bound.
@export var key_names: Dictionary = {}
@export var pad_names: Dictionary = {}
## The "???" shown while a row waits for input.
@export var capture: Dictionary = {}

func entry(name: String) -> Dictionary:
	for item in entries:
		if str(item["name"]) == name:
			return item
	return {}
